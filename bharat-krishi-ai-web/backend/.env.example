# Optional: enables Gemini-generated answers constrained to retrieved knowledge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local prototype data paths (relative paths resolve from backend/).
ADVISORY_DATABASE_PATH=data/advisory.sqlite3
ADVISORY_CHROMA_PATH=data/chroma
ADVISORY_TOP_K=3
ADVISORY_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
